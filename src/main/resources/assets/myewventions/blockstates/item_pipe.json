{
  "multipart": [
    {
      "apply": {
        "model": "myewventions:block/item_pipe_center"
      },
      "when": {
        "active": false
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_center_active"
      },
      "when": {
        "active": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true
      },
      "when": {
        "north": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true,
        "x": 270
      },
      "when": {
        "up": true
      }
    },
    {
      "apply": {
        "model": "myewventions:block/item_pipe_side",
        "uvlock": true,
        "x": 90
      },
      "when": {
        "down": true
      }
    }
  ]
}